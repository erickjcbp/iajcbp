{
  "crons": [
    {
      "path": "/api/cron-crm?turno=manha",
      "schedule": "0 11 * * *"
    },
    {
      "path": "/api/cron-crm?turno=tarde",
      "schedule": "0 21 * * *"
    },
    {
      "path": "/api/acolito-admin?action=jornada_rotina&modo=motor",
      "schedule": "0 11 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "coroinhas.jcbplimeira.com.br"
        }
      ],
      "destination": "/projetos/acolitos/login.html",
      "permanent": false
    },
    {
      "source": "/",
      "destination": "/projetos/central/login.html",
      "permanent": false
    },
    {
      "source": "/central",
      "destination": "/projetos/central/central.html",
      "permanent": false
    },
    {
      "source": "/pastorais",
      "destination": "/projetos/central/pastorais.html",
      "permanent": false
    },
    {
      "source": "/acolitos",
      "destination": "/projetos/acolitos/index.html",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/ausencias",
      "has": [
        {
          "type": "host",
          "value": "coroinhas.jcbplimeira.com.br"
        }
      ],
      "destination": "/projetos/acolitos/ausencias-publica.html"
    },
    {
      "source": "/pastoral",
      "has": [
        {
          "type": "host",
          "value": "coroinhas.jcbplimeira.com.br"
        }
      ],
      "destination": "/projetos/acolitos/pastoral.html"
    },
    {
      "source": "/novena",
      "has": [
        {
          "type": "host",
          "value": "coroinhas.jcbplimeira.com.br"
        }
      ],
      "destination": "/projetos/acolitos/novena-publica.html"
    },
    {
      "source": "/finados",
      "has": [
        {
          "type": "host",
          "value": "coroinhas.jcbplimeira.com.br"
        }
      ],
      "destination": "/projetos/acolitos/novena-publica.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*\\.html)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/(ausencias|pastoral|novena|finados)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/projetos/acolitos/games-art/mensageiro/cidade-leve-v3.webp",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
